##############################################################################
# Incident Management Bot for MAX — example configuration.
# Copy to .env and fill in. NEVER commit the real .env.
##############################################################################

NODE_ENV=production
LOG_LEVEL=info
# Human-readable console logs; leave false for JSON in production.
LOG_PRETTY=false

# --- MAX -------------------------------------------------------------------
# Token issued by @MasterBot in MAX. Secret: keep it out of git and out of logs.
BOT_TOKEN=REPLACE_WITH_YOUR_NEW_MAX_BOT_TOKEN
MAX_API_BASE_URL=https://platform-api2.max.ru

# --- Database --------------------------------------------------------------
# Docker Compose reads POSTGRES_* to initialize a NEW volume and to build the
# app's DATABASE_URL. Setting DATABASE_URL alone does not override Compose.
# For an existing volume, use its actual role/database/password: editing .env
# does NOT change credentials stored in PostgreSQL. Never delete data to fix auth.
POSTGRES_USER=incident
POSTGRES_DB=incident
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_OR_NEW_DATABASE_PASSWORD
# Host-published port only; app-to-postgres traffic always uses postgres:5432.
POSTGRES_PORT=5432
# Keep credentials consistent with POSTGRES_*. Compose overrides this URL.
# The current Compose inserts the password without URL encoding: use a password
# of AT LEAST 20 characters made of Latin letters/digits/underscore/hyphen.
# This is the handover checker policy, not a PostgreSQL engine limitation.
# For an existing incompatible password,
# coordinate an interactive password change; do not encode POSTGRES_PASSWORD.
DATABASE_URL=postgresql://incident:REPLACE_WITH_EXISTING_OR_NEW_DATABASE_PASSWORD@postgres:5432/incident?schema=public&connection_limit=20&pool_timeout=20
# Only when running Node directly on the HOST, use 127.0.0.1 and POSTGRES_PORT.
# Prisma pool size. Default is num_cpus*2+1, which is too small on a small
# host: a burst of simultaneous registrations then fails on the 2s wait for a
# connection. Keep it well under the server's max_connections (100).
DB_CONNECTION_LIMIT=20

# --- Locale ----------------------------------------------------------------
# Calendar days for the daily limit and publicCode are computed in this zone.
APP_TIMEZONE=Europe/Moscow

# --- Transport -------------------------------------------------------------
# webhook (required in production) | polling (development only)
BOT_MODE=webhook
# Domain served by the bundled Caddy (docker compose --profile tls).
# Must already resolve to this host — Let's Encrypt validates it on first start.
PUBLIC_DOMAIN=YOUR_DOMAIN.example
# Public HTTPS URL that terminates at WEBHOOK_PATH below.
WEBHOOK_URL=https://YOUR_DOMAIN.example/webhook/max
# 5-256 chars. MAX echoes it in the X-Max-Bot-Api-Secret header on every call.
WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
WEBHOOK_PATH=/webhook/max
# Installation: register separately AFTER database/identity/HTTPS checks.
# false does NOT disable the application's workers if you start app.
WEBHOOK_AUTO_REGISTER=false
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# --- Working chats ---------------------------------------------------------
# Add the bot to each chat; it replies with the chat id, or use /chatid.
# Use the agreed chat IDs (handover: config/business-settings.env).
DISTRIBUTION_CHAT_ID=-78339479576634
DISTRIBUTION_QUEUE_ENABLED=true
# SLA and distribution alerts: Monday-Friday, Moscow time. Intake remains available 24/7.
WORKDAY_START=08:00
WORKDAY_END=17:00
DISTRIBUTION_OVERLOAD_COUNT=30
REVIEW_CHAT_ID=-78339493797946
# Profile chat ids live in the ResponsibleGroup table: /group_chat <CODE> <CHAT_ID>

# --- Business rules --------------------------------------------------------
DAILY_INCIDENT_LIMIT=3
INCIDENT_MAX_LENGTH=150
INCIDENT_SLA_WORKDAYS=3
SLA_ENABLED=true
SLA_CHECK_INTERVAL_MINUTES=10
SESSION_TTL_MINUTES=10
MY_INCIDENTS_LIMIT=10

# --- Legal documents and explicit consent ---------------------------------
# The repository template stays false. Enable only after publishing final PDFs,
# filling all three SHA-256 values and completing the RUNBOOK checks.
LEGAL_CONSENT_REQUIRED=false
LEGAL_DOCUMENTS_BASE_URL=https://YOUR_DOMAIN.example/documents
LEGAL_DOCUMENT_VERSION=3.4
# Optional separate agreement revision; existing personal-data consent stays valid.
LEGAL_USER_AGREEMENT_VERSION=3.4
# SHA-256 of each exact published PDF. Recalculate and bump the version after
# every material document change; old confirmations will then stop granting access.
LEGAL_USER_AGREEMENT_SHA256=e7114f6220c5516552695a0ae5df685a44af4f72649d74e41d313f2530fe285e
LEGAL_PRIVACY_POLICY_SHA256=c84449d34702d6d35f65ad9b01f9bc0d3de50b72f9265f87bd8bbea600f590fc
LEGAL_PERSONAL_DATA_CONSENT_SHA256=d5c1f03c6b80e117d161820ae801bf07aa5c8ee76a6b993b00038d1072a74a9b

# --- Media storage ---------------------------------------------------------
# local (development) | s3 (production, any S3-compatible store incl. MinIO)
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=/app/data/uploads
# Per-file download cap in MiB (1–100); enforced even without Content-Length.
MEDIA_MAX_FILE_MB=20
# Different users may run concurrently; each user's events remain ordered.
INBOX_CONCURRENCY=8
# Parallel background deliveries to distinct recipients; one at a time per recipient.
OUTBOX_CONCURRENCY=8
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Roles -----------------------------------------------------------------
# Comma-separated MAX user ids. These merge with roles stored in the database,
# so they are only needed to bootstrap the first administrators.
ADMINS=
DISPATCHERS=
APPROVERS=
RESPONDERS=

# --- Technical alerts -------------------------------------------------------
# A private MAX chat where the bot reports delivery failures. Keep empty to
# disable alerts (failures remain visible through /delivery_status and doctor).
DELIVERY_ALERT_CHAT_ID=-78476336308282
# Handover: use DELIVERY_ALERT_CHAT_ID from config/business-settings.env.
# NODE_EXTRA_CA_CERTS is already supplied by docker-compose.yml; do not disable TLS.

// Incident Management Bot for MAX — database schema.
//
// Design rules encoded here:
//  * Incident.id (uuid) is the ONLY source of truth linking a request to its
//    author, sector, answers and final delivery. publicCode is a human label.
//  * Nothing important lives in process memory: sessions, dedup markers and
//    SLA notification flags are all persisted so a restart changes nothing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentStatus {
  NEW
  DISTRIBUTION
  ASSIGNED
  IN_PROGRESS
  WAITING_REVIEW
  REVISION_REQUIRED
  REJECTED
  RESOLVED
}

enum AnswerStatus {
  DRAFT
  WAITING_REVIEW
  APPROVED
  REVISION_REQUIRED
}

enum AttachmentType {
  IMAGE
  FILE
}

enum ClarificationStatus {
  DRAFT
  PENDING_DELIVERY
  WAITING_REPLY
  ANSWERED
  CANCELLED
}

enum SessionType {
  WAITING_CLARIFICATION_QUESTION
  WAITING_CLARIFICATION_REPLY
  WAITING_REQUESTER_NAME
  WAITING_REQUESTER_PHONE
  WAITING_INCIDENT_SELECTION
  WAITING_INCIDENT_TEXT
  WAITING_CUSTOM_LOCALITY
  WAITING_INCIDENT_CONFIRMATION
  WAITING_INCIDENT_EDIT_SELECTION
  WAITING_INCIDENT_EDIT_VALUE
  WAITING_REJECTION_REASON
  WAITING_REVISION_REASON
  WAITING_FOR_ANSWER
  WAITING_BAN_REASON
  WAITING_REPORT_PERIOD
}

enum ResponsibleGroupKind {
  REGIONAL
  LOCAL_GOVERNMENT
  EXECUTIVE_AUTHORITY
}

enum LegalAcceptanceType {
  USER_AGREEMENT
  PERSONAL_DATA_CONSENT
}

enum UserRole {
  REQUESTER
  DISPATCHER
  RESPONDER
  APPROVER
  ADMIN
}

enum InboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum DeliveryTrackingType {
  DISTRIBUTION_CARD
  SECTOR_CARD
  REVIEW_CARD
  ANSWER_TO_REQUESTER
}

model User {
  id          String     @id @default(uuid())
  maxUserId   BigInt     @unique
  displayName String
  username    String?
  /// Confirmed requester details reused for subsequent incident drafts.
  requesterName  String?
  requesterPhone String?
  roles       UserRole[] @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  incidents       Incident[]       @relation("IncidentRequester")
  assignedByMe    Incident[]       @relation("IncidentAssignedBy")
  respondingTo    Incident[]       @relation("IncidentResponder")
  approvedByMe    Incident[]       @relation("IncidentApprover")
  authoredAnswers IncidentAnswer[] @relation("AnswerAuthor")
  approvedAnswers IncidentAnswer[] @relation("AnswerApprover")
  bansIssued      Ban[]            @relation("BanAuthor")
  legalAcceptances LegalAcceptance[]

  @@index([maxUserId])
}

/// Evidence of an explicit legal confirmation made in the private MAX dialog.
/// Each document revision is accepted separately; the first successful click
/// is immutable and repeated clicks are idempotent through the compound key.
model LegalAcceptance {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxUserId        BigInt
  type             LegalAcceptanceType
  documentVersion  String
  documentUrl      String
  documentSha256   String
  confirmationText String
  sourceCallbackId String?             @unique
  sourceMessageId  String?
  sourceChatId     BigInt?
  acceptedAt       DateTime            @default(now())

  @@unique([userId, type, documentVersion])
  @@index([maxUserId, acceptedAt])
  @@index([type, documentVersion])
}

model Category {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSelectedIncidents Incident[] @relation("UserSelectedCategory")

  @@index([isActive, sortOrder])
}

/// Получатель обращения после ручного распределения. Темы, которые выбирает
/// заявитель, намеренно хранятся отдельно в Category.
model ResponsibleGroup {
  id               String               @id @default(uuid())
  code             String               @unique
  name             String
  kind             ResponsibleGroupKind
  maxChatId        BigInt?              @unique
  /// Код территории, для которой группа показывается как рекомендация.
  municipalityCode String?              @unique
  authorityName    String?
  answerTemplate   String?
  bypassReview     Boolean              @default(false)
  isActive         Boolean              @default(true)
  sortOrder        Int                  @default(100)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assignedIncidents Incident[] @relation("AssignedResponsibleGroup")

  @@index([kind, isActive, sortOrder])
}

model Incident {
  id         String @id @default(uuid())
  publicCode String @unique
  distributionClaimedBy BigInt?
  distributionClaimedName String?
  distributionClaimUntil DateTime?

  @@index([status, createdAt, id])
  @@index([distributionClaimedBy, distributionClaimUntil])

  requesterId        String
  requester          User   @relation("IncidentRequester", fields: [requesterId], references: [id])
  requesterMaxUserId BigInt
  requesterName      String
  /// Null only for legacy incidents created before mandatory contact collection.
  requesterPhone     String?

  text String

  userSelectedCategoryId String?
  userSelectedCategory   Category?         @relation("UserSelectedCategory", fields: [userSelectedCategoryId], references: [id])
  assignedGroupId        String?
  assignedGroup          ResponsibleGroup? @relation("AssignedResponsibleGroup", fields: [assignedGroupId], references: [id])

  /// Территория проблемы выбирается независимо от темы обращения.
  problemMunicipalityCode String?
  problemMunicipalityName String?
  problemLocality         String?

  status IncidentStatus @default(DISTRIBUTION)

  createdAt  DateTime  @default(now())
  deadlineAt DateTime
  answeredAt DateTime?
  /// Optional one-time requester score for the delivered final answer.
  responseRating Int?
  ratedAt       DateTime?
  updatedAt  DateTime  @updatedAt

  // MAX message ids of the cards published in the working chats.
  distributionMessageId String?
  sectorMessageId       String?
  reviewMessageId       String?

  assignedAt       DateTime?
  assignedByUserId String?
  assignedBy       User?     @relation("IncidentAssignedBy", fields: [assignedByUserId], references: [id])

  currentResponderId String?
  currentResponder   User?   @relation("IncidentResponder", fields: [currentResponderId], references: [id])

  approvedByUserId String?
  approvedBy       User?   @relation("IncidentApprover", fields: [approvedByUserId], references: [id])

  revisionCount   Int     @default(0)
  rejectionReason String?
  revisionReason  String?

  activeClarificationId String? @unique
  slaPausedAt DateTime?
  slaPausedMs BigInt @default(0)
  clarifications Clarification[]

  isOverdue         Boolean   @default(false)
  slaReminder24SentAt DateTime?
  /// Legacy name: also records the reminder at 48h after creation.
  slaWarn24SentAt   DateTime?
  slaWarn6SentAt    DateTime?
  overdueNotifiedAt DateTime?

  attachments IncidentAttachment[]
  answers     IncidentAnswer[]
  history     IncidentHistory[]
  sessions    OperatorSession[]

  @@index([requesterId, createdAt])
  @@index([requesterMaxUserId, createdAt])
  @@index([status])
  @@index([status, answeredAt])
  @@index([responseRating])
  @@index([deadlineAt])
  @@index([assignedGroupId])
  @@index([problemMunicipalityCode])
  @@index([createdAt])
}

model IncidentAttachment {
  id           String         @id @default(uuid())
  incidentId   String
  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type         AttachmentType
  storageKey   String
  mimeType     String?
  originalName String?
  size         Int?
  sourceUrl    String?
  maxToken     String?
  createdAt    DateTime       @default(now())

  @@index([incidentId])
}

model IncidentAnswer {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  version    Int
  text       String

  createdByUserId String
  createdBy       User     @relation("AnswerAuthor", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  status AnswerStatus @default(DRAFT)

  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?     @relation("AnswerApprover", fields: [approvedByUserId], references: [id])

  revisionReason String?
  deliveredAt    DateTime?

  attachments AnswerAttachment[]

  @@unique([incidentId, version])
  @@index([incidentId, status])
}

model AnswerAttachment {
  id           String         @id @default(uuid())
  answerId     String
  answer       IncidentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  type         AttachmentType
  storageKey   String
  mimeType     String?
  originalName String?
  size         Int?
  sourceUrl    String?
  maxToken     String?
  createdAt    DateTime       @default(now())

  @@index([answerId])
}

model IncidentHistory {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  action     String
  fromStatus IncidentStatus?
  toStatus   IncidentStatus?

  actorMaxUserId BigInt?
  actorRole      String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([action])
}

/// Append-only record of successful administrative commands. It is separate
/// from IncidentHistory because role, category and delivery operations may not
/// belong to one incident.
model AdminAuditLog {
  id             String   @id @default(uuid())
  action         String
  actorMaxUserId BigInt
  actorName      String
  targetType     String?
  targetId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorMaxUserId, createdAt])
  @@index([action])
}

model Ban {
  id        String  @id @default(uuid())
  maxUserId BigInt
  reason    String
  isActive  Boolean @default(true)

  createdById String?
  createdBy   User?     @relation("BanAuthor", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([maxUserId, isActive])
}

model OperatorSession {
  id         String      @id @default(uuid())
  maxUserId  BigInt
  chatId     BigInt
  type       SessionType
  incidentId String?
  incident   Incident?   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  data       Json?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())

  @@unique([maxUserId, chatId])
  @@index([maxUserId, chatId])
  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Atomic per-day counter backing Incident.publicCode (INC-YYYYMMDD-NNNN).
model IncidentCounter {
  day        String @id
  lastNumber Int    @default(0)
}

/// Webhook idempotency: an update whose key is already here is never replayed.
model ProcessedUpdate {
  id                String   @id @default(uuid())
  externalUpdateKey String   @unique
  updateType        String
  processedAt       DateTime @default(now())

  @@index([processedAt])
}

/// Durable copy of every accepted webhook update. Unlike ProcessedUpdate,
/// this row keeps the payload and processing state so a restart cannot lose
/// work after the HTTP 200 response has already been returned to MAX.
model InboundUpdate {
  id                String      @id @default(uuid())
  externalUpdateKey String      @unique
  updateType        String
  partitionKey      String      @default("legacy")
  sequence          BigInt      @unique @default(autoincrement())
  payload           Json
  status            InboxStatus @default(PENDING)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now())
  lockedAt          DateTime?
  lastError         String?
  receivedAt        DateTime    @default(now())
  processedAt       DateTime?
  deliveryAlertedAt DateTime?
  updatedAt         DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, deliveryAlertedAt])
  @@index([lockedAt])
  @@index([receivedAt])
  @@index([status, partitionKey, sequence])
}

/// Persistent outgoing MAX message. The logical message and staged attachment
/// references survive process restarts; a worker keeps retrying until SENT or
/// the bounded failure threshold is reached.
model OutboundMessage {
  id                String                @id @default(uuid())
  dedupeKey         String?               @unique
  targetType        String
  targetId          BigInt
  payload           Json
  attachments       Json
  status            OutboxStatus          @default(PENDING)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  lockedAt          DateTime?
  lastError         String?
  firstMessageId    String?
  trackingType      DeliveryTrackingType?
  incidentId        String?
  answerId          String?
  trackingApplied   Boolean               @default(false)
  createdAt         DateTime              @default(now())
  sentAt            DateTime?
  deliveryAlertedAt DateTime?
  updatedAt         DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, deliveryAlertedAt])
  @@index([lockedAt])
  @@index([incidentId])
  @@index([createdAt])
}

/// Short database-backed lease used to debounce repeated button presses. A
/// crashed process cannot leave a permanent lock because every row expires.
model ActionLock {
  key         String   @id
  maxUserId   BigInt
  incidentId  String?
  action      String
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
  @@index([maxUserId])
  @@index([incidentId])
}

model Clarification {
  id String @id @default(uuid())
  incidentId String
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status ClarificationStatus @default(DRAFT)
  question String
  askedByUserId String
  askedByMaxUserId BigInt
  chatId BigInt
  questionSourceId String @unique
  replySourceId String?
  replyText String?
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  answeredAt DateTime?
  attachments ClarificationAttachment[]
  @@index([incidentId, createdAt])
}

model ClarificationAttachment {
  id String @id @default(uuid())
  clarificationId String
  clarification Clarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  type AttachmentType
  storageKey String
  originalName String?
  size Int?
  @@index([clarificationId])
}
